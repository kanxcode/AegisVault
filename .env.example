# AegisVault Backend Environment Configuration
# Copy this file to .env and adjust values as needed.
# Never commit .env or real database credentials to version control.

# Default local SQLite database (relative to backend/ working directory)
DATABASE_URL=sqlite:///./aegis.db

# Example MySQL / PyMySQL connection string:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/aegis
